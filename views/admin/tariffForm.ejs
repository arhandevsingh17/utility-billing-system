<% layout('layouts/dashboard') %>
<h4 class="mb-3">Add tariff</h4>
<div class="card border-0 shadow-sm" style="max-width:760px"><div class="card-body p-4">
<form method="POST" action="/admin/tariffs">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Tariff name</label>
      <input name="name" class="form-control" placeholder="Domestic Demo Tariff 2025" required></div>
    <div class="col-md-3"><label class="form-label">Connection type</label>
      <select name="connectionType" class="form-select" required>
        <option>Domestic</option><option>Commercial</option></select></div>
    <div class="col-md-3"><label class="form-label">Fixed charge</label>
      <input type="number" name="fixedCharge" class="form-control" value="50" min="0" step="0.01" required></div>
  </div>

  <hr class="my-4">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <div><strong>Slabs</strong>
      <div class="form-text mb-0">Enter boundaries: 0&rarr;100, 100&rarr;200, 200&rarr;500, 500&rarr;blank.
        Leave the last "to" empty for an unbounded top slab. Slabs must be continuous.</div></div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="addSlab">+ Row</button>
  </div>

  <table class="table table-sm align-middle" id="slabTable">
    <thead><tr><th>From</th><th>To</th><th>Rate / kWh</th><th></th></tr></thead>
    <tbody>
      <tr><td><input name="from" value="0"   class="form-control form-control-sm" type="number" min="0"></td>
          <td><input name="to"   value="100" class="form-control form-control-sm" type="number"></td>
          <td><input name="rate" value="3"   class="form-control form-control-sm" type="number" step="0.01"></td>
          <td><button type="button" class="btn btn-sm btn-link text-danger removeSlab">remove</button></td></tr>
      <tr><td><input name="from" value="100" class="form-control form-control-sm" type="number" min="0"></td>
          <td><input name="to"   value="200" class="form-control form-control-sm" type="number"></td>
          <td><input name="rate" value="5"   class="form-control form-control-sm" type="number" step="0.01"></td>
          <td><button type="button" class="btn btn-sm btn-link text-danger removeSlab">remove</button></td></tr>
      <tr><td><input name="from" value="200" class="form-control form-control-sm" type="number" min="0"></td>
          <td><input name="to"   value="500" class="form-control form-control-sm" type="number"></td>
          <td><input name="rate" value="7"   class="form-control form-control-sm" type="number" step="0.01"></td>
          <td><button type="button" class="btn btn-sm btn-link text-danger removeSlab">remove</button></td></tr>
      <tr><td><input name="from" value="500" class="form-control form-control-sm" type="number" min="0"></td>
          <td><input name="to"   value=""    class="form-control form-control-sm" type="number" placeholder="unbounded"></td>
          <td><input name="rate" value="10"  class="form-control form-control-sm" type="number" step="0.01"></td>
          <td><button type="button" class="btn btn-sm btn-link text-danger removeSlab">remove</button></td></tr>
    </tbody>
  </table>

  <div class="alert alert-info small">Creating a tariff makes it the <strong>active</strong> tariff for that connection type; the previous one is deactivated but kept for history.</div>
  <button class="btn btn-primary">Create tariff</button>
  <a href="/admin/tariffs" class="btn btn-outline-secondary">Cancel</a>
</form>
</div></div>

<script>
  document.getElementById('addSlab').addEventListener('click', function () {
    var tbody = document.querySelector('#slabTable tbody');
    var row = tbody.rows[tbody.rows.length - 1].cloneNode(true);
    row.querySelectorAll('input').forEach(function (i) { i.value = ''; });
    tbody.appendChild(row);
  });
  document.querySelector('#slabTable').addEventListener('click', function (e) {
    if (e.target.classList.contains('removeSlab')) {
      var tbody = document.querySelector('#slabTable tbody');
      if (tbody.rows.length > 1) e.target.closest('tr').remove();
    }
  });
</script>
