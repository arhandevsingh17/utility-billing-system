<% layout('layouts/dashboard') %>
<h4 class="mb-1">Admin Dashboard</h4>
<p class="text-muted small mb-4">All figures are calculated live from MongoDB.</p>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card stat-card border-0 shadow-sm h-100"><div class="card-body">
    <div class="text-muted small text-uppercase">Bills generated</div>
    <div class="fs-3 fw-semibold"><%= stats.totalBills %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card border-0 shadow-sm h-100 border-start border-success border-4"><div class="card-body">
    <div class="text-muted small text-uppercase">Paid</div>
    <div class="fs-3 fw-semibold text-success"><%= stats.paid.count %></div>
    <div class="small text-muted"><%= h.formatCurrency(stats.paid.amount) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card border-0 shadow-sm h-100 border-start border-warning border-4"><div class="card-body">
    <div class="text-muted small text-uppercase">Unpaid</div>
    <div class="fs-3 fw-semibold text-warning"><%= stats.unpaid.count %></div>
    <div class="small text-muted"><%= h.formatCurrency(stats.unpaid.amount) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card border-0 shadow-sm h-100 border-start border-danger border-4"><div class="card-body">
    <div class="text-muted small text-uppercase">Overdue</div>
    <div class="fs-3 fw-semibold text-danger"><%= stats.overdue.count %></div>
    <div class="small text-muted"><%= h.formatCurrency(stats.overdue.amount) %></div></div></div></div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Total units billed</div>
    <div class="fs-4 fw-semibold"><%= stats.totalUnits.toLocaleString('en-IN') %> kWh</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Consumers</div>
    <div class="fs-4 fw-semibold"><%= stats.totalConsumers %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Meters (active)</div>
    <div class="fs-4 fw-semibold"><%= stats.totalMeters %> <span class="fs-6 text-muted">/ <%= stats.activeMeters %></span></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Readings recorded</div>
    <div class="fs-4 fw-semibold"><%= stats.totalReadings %></div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body">
    <h6 class="mb-3">Monthly consumption &amp; collected revenue</h6>
    <% if (monthly.length) { %>
      <canvas id="adminMonthlyChart" height="140"
        data-labels='<%- JSON.stringify(monthly.map(function(m){ return h.formatMonth(m._id); })) %>'
        data-units='<%- JSON.stringify(monthly.map(function(m){ return m.units; })) %>'
        data-revenue='<%- JSON.stringify(monthly.map(function(m){ return m.revenue; })) %>'></canvas>
    <% } else { %><%- include('../partials/empty', { emptyTitle: 'No bills yet', emptyText: 'Ask a meter reader to record a reading.' }) %><% } %>
  </div></div></div>

  <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body">
    <h6 class="mb-3">Top consumers by units</h6>
    <% if (topConsumers.length) { %>
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Consumer</th><th class="text-end">Units</th><th class="text-end">Billed</th></tr></thead>
        <tbody>
          <% topConsumers.forEach(function(c){ %>
            <tr>
              <td><div class="fw-semibold small"><%= c.name %></div><div class="text-muted small"><%= c.consumerId || '-' %></div></td>
              <td class="text-end"><%= c.units %> kWh</td>
              <td class="text-end"><%= h.formatCurrency(c.amount) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %><%- include('../partials/empty', { emptyTitle: 'No consumption data yet', emptyText: '' }) %><% } %>
  </div></div></div>
</div>
