<% layout('layouts/dashboard') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h4 class="mb-0">Meters</h4><p class="text-muted small mb-0"><%= meters.length %> meter(s)</p></div>
  <a href="/admin/meters/new" class="btn btn-sm btn-primary">+ Add meter</a>
</div>
<div class="card border-0 shadow-sm"><div class="card-body p-0">
<% if (meters.length) { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Meter no.</th><th>Consumer</th><th>Type</th><th>Installed</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% meters.forEach(function(m){ %>
      <tr>
        <td><code><%= m.meterNumber %></code></td>
        <td><div class="fw-semibold small"><%= m.consumer ? m.consumer.name : '(deleted)' %></div>
            <div class="text-muted small"><%= m.consumer ? m.consumer.consumerId : '' %></div></td>
        <td><span class="badge bg-light text-dark"><%= m.connectionType %></span></td>
        <td class="small"><%= h.formatDate(m.installationDate) %></td>
        <td><span class="badge bg-<%= m.status === 'Active' ? 'success' : 'secondary' %>"><%= m.status %></span></td>
        <td class="text-end">
          <form method="POST" action="/admin/meters/<%= m._id %>/toggle?_method=PUT" class="d-inline">
            <button class="btn btn-sm btn-outline-secondary"><%= m.status === 'Active' ? 'Deactivate' : 'Activate' %></button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody></table></div>
<% } else { %><%- include('../partials/empty', { emptyTitle: 'No meters yet', emptyText: 'Add a meter and assign it to a consumer.' }) %><% } %>
</div></div>
