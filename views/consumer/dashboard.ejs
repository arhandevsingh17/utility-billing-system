<% layout('layouts/dashboard') %>
<h4 class="mb-1">Hello, <%= currentUser.name %></h4>
<p class="text-muted small mb-4">Consumer ID <code><%= currentUser.consumerId || '-' %></code>
  &middot; <%= currentUser.connectionType || '-' %> connection</p>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Current bill</div>
    <div class="fs-4 fw-semibold"><%= latest ? h.formatCurrency(latest.totalAmount) : '-' %></div>
    <% if (latest) { %><%- include('../partials/statusBadge', { status: latest.status }) %><% } %>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Unpaid</div>
    <div class="fs-4 fw-semibold text-warning"><%= stats.unpaid.count %></div>
    <div class="small text-muted"><%= h.formatCurrency(stats.unpaid.amount) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Overdue</div>
    <div class="fs-4 fw-semibold text-danger"><%= stats.overdue.count %></div>
    <div class="small text-muted"><%= h.formatCurrency(stats.overdue.amount) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="text-muted small text-uppercase">Units (last 6 bills)</div>
    <div class="fs-4 fw-semibold"><%= stats.totalUnits %> kWh</div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body">
    <h6 class="mb-3">Recent bills</h6>
    <% if (recent.length) { %>
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Month</th><th class="text-end">Units</th><th class="text-end">Amount</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% recent.forEach(function(b){ %>
          <tr><td class="small"><%= h.formatMonth(b.billingMonth) %></td>
              <td class="text-end"><%= b.unitsConsumed %></td>
              <td class="text-end fw-semibold"><%= h.formatCurrency(b.totalAmount) %></td>
              <td><%- include('../partials/statusBadge', { status: b.status }) %></td>
              <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/consumer/bills/<%= b._id %>">View</a></td></tr>
        <% }) %>
        </tbody></table>
    <% } else { %><%- include('../partials/empty', { emptyTitle: 'No bills yet', emptyText: 'A bill appears after your meter is read.' }) %><% } %>
  </div></div></div>

  <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body">
    <h6 class="mb-3">My meters</h6>
    <% if (meters.length) { %>
      <ul class="list-group list-group-flush">
        <% meters.forEach(function(m){ %>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span><code><%= m.meterNumber %></code> <span class="text-muted small"><%= m.connectionType %></span></span>
            <span class="badge bg-<%= m.status === 'Active' ? 'success' : 'secondary' %>"><%= m.status %></span></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-muted small mb-0">No meter is linked to your account yet. The administrator assigns one after registration.</p>
    <% } %>
  </div></div></div>
</div>
