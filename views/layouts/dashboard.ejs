<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' \u00B7 ' + appName : appName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-body-tertiary">
  <%- include('../partials/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <aside class="col-lg-2 col-md-3 sidebar p-0"><%- include('../partials/sidebar') %></aside>
      <div class="col-lg-10 col-md-9 py-4 px-md-4">
        <%- include('../partials/flash') %>
        <%- body %>
        <div class="mt-5"><%- include('../partials/footer') %></div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script src="/js/chart.js"></script>
</body>
</html>
