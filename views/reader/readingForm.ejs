<% layout('layouts/dashboard') %>
<h4 class="mb-3">Enter meter reading</h4>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
    <% if (!meters.length) { %>
      <div class="alert alert-warning mb-0">No active meters. Ask the admin to add one.</div>
    <% } else { %>
    <form method="POST" action="/reader/readings" id="readingForm">
      <div class="mb-3"><label class="form-label">Meter</label>
        <select name="meter" id="meterSelect" class="form-select" required>
          <option value="">-- select a meter --</option>
          <% meters.forEach(function(m){ %>
            <option value="<%= m._id %>"
                    data-prev="<%= lastMap[String(m._id)] ? lastMap[String(m._id)].currentReading : 0 %>"
                    <%= String(selectedMeter) === String(m._id) ? 'selected' : '' %>>
              <%= m.meterNumber %> &middot; <%= m.consumer ? m.consumer.name : '-' %> (<%= m.connectionType %>)
            </option>
          <% }) %>
        </select></div>

      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Previous reading (from database)</label>
          <input id="prevReading" class="form-control" value="0" readonly>
          <div class="form-text">Read-only. The server recomputes this and ignores anything sent here.</div></div>
        <div class="col-md-6"><label class="form-label">Current reading (kWh)</label>
          <input type="number" name="currentReading" id="currReading" class="form-control" min="0" step="1" required></div>
        <div class="col-md-6"><label class="form-label">Billing month</label>
          <input type="month" name="billingMonth" class="form-control" value="<%= defaultMonth %>" required></div>
        <div class="col-md-6"><label class="form-label">Reading date</label>
          <input type="date" name="readingDate" class="form-control"></div>
      </div>

      <div class="alert alert-light border mt-3 mb-3 d-flex justify-content-between">
        <span>Units that will be billed</span>
        <strong id="unitsPreview">&mdash;</strong>
      </div>
      <div id="warning" class="alert alert-danger d-none">Current reading is lower than the previous reading. The server will reject this.</div>

      <button class="btn btn-primary">Save reading &amp; generate bill</button>
      <a href="/reader/readings" class="btn btn-outline-secondary">Cancel</a>
    </form>
    <% } %>
    </div></div>
  </div>

  <div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body">
    <h6>What happens when you submit</h6>
    <ol class="small text-muted ps-3 mb-3">
      <li>Meter is checked (must exist and be Active)</li>
      <li>Billing month format is checked</li>
      <li>Previous reading is loaded <strong>from the database</strong></li>
      <li>Reading lower than previous &rarr; rejected</li>
      <li>Duplicate meter + month &rarr; rejected</li>
      <li>Units = current &minus; previous</li>
      <li>Bill generated from the active tariff slabs</li>
    </ol>
    <div class="alert alert-secondary small mb-0">The preview on the left is a convenience only. Every rule above is enforced again on the server.</div>
  </div></div></div>
</div>

<script>
  var sel = document.getElementById('meterSelect');
  var prev = document.getElementById('prevReading');
  var curr = document.getElementById('currReading');
  var preview = document.getElementById('unitsPreview');
  var warn = document.getElementById('warning');

  function refresh() {
    var opt = sel.options[sel.selectedIndex];
    var p = opt && opt.dataset.prev ? Number(opt.dataset.prev) : 0;
    prev.value = p;
    curr.min = p;
    var c = Number(curr.value);
    if (curr.value === '') { preview.textContent = '\u2014'; warn.classList.add('d-none'); return; }
    preview.textContent = (c - p) + ' kWh';
    warn.classList.toggle('d-none', c >= p);
  }
  if (sel) { sel.addEventListener('change', refresh); curr.addEventListener('input', refresh); refresh(); }
</script>
