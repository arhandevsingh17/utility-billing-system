<% layout('layouts/dashboard') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div><h4 class="mb-0">Readings</h4><p class="text-muted small mb-0"><%= readings.length %> record(s)</p></div>
  <div class="d-flex gap-2">
    <form class="d-flex gap-2" method="GET" action="/reader/readings">
      <select name="month" class="form-select form-select-sm">
        <option value="">All months</option>
        <% months.forEach(function(m){ %>
          <option value="<%= m %>" <%= filters.month === m ? 'selected' : '' %>><%= h.formatMonth(m) %></option>
        <% }) %>
      </select>
      <select name="mine" class="form-select form-select-sm">
        <option value="">Everyone</option>
        <option value="1" <%= filters.mine === '1' ? 'selected' : '' %>>Only mine</option>
      </select>
      <button class="btn btn-sm btn-outline-secondary">Filter</button>
    </form>
    <a href="/reader/readings/new" class="btn btn-sm btn-primary">+ New</a>
  </div>
</div>

<div class="card border-0 shadow-sm"><div class="card-body p-0">
<% if (readings.length) { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Meter</th><th>Consumer</th><th>Month</th><th class="text-end">Previous</th>
      <th class="text-end">Current</th><th class="text-end">Units</th><th>Date</th><th>Entered by</th></tr></thead>
    <tbody>
    <% readings.forEach(function(r){ %>
      <tr>
        <td><code class="small"><%= r.meter ? r.meter.meterNumber : '-' %></code></td>
        <td><div class="small fw-semibold"><%= r.consumer ? r.consumer.name : '-' %></div>
            <div class="text-muted small"><%= r.consumer ? r.consumer.consumerId : '' %></div></td>
        <td class="small"><%= h.formatMonth(r.billingMonth) %></td>
        <td class="text-end"><%= r.previousReading %></td>
        <td class="text-end"><%= r.currentReading %></td>
        <td class="text-end fw-semibold"><%= r.unitsConsumed %> kWh</td>
        <td class="small"><%= h.formatDate(r.readingDate) %></td>
        <td class="small text-muted"><%= r.enteredBy ? r.enteredBy.name : '-' %></td>
      </tr>
    <% }) %>
    </tbody></table></div>
<% } else { %><%- include('../partials/empty', { emptyTitle: 'No readings found', emptyText: 'Record the first reading for a meter.' }) %><% } %>
</div></div>
